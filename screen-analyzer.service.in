[Unit]
Description=The phenosaurus web service
After=network.target
Wants=network-online.target

[Service]
Restart=on-failure
Type=forking
PIDFile=@SCREEN_ANALYZER_PID@
ExecStart=@SCREEN_ANALYZER_EXE@ server start --config=@CONFIG_FILE@
ExecReload=@SCREEN_ANALYZER_EXE@ server reload --config=@CONFIG_FILE@
ExecStop=@SCREEN_ANALYZER_EXE@ server stop --config=@CONFIG_FILE@

[Install]
WantedBy=multi-user.target
