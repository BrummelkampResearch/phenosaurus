{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "make screen-analyzer",
            "command": "make",
            "args": [
				"DEBUG=1",
                "screen-analyzer"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
		},
		{
            "type": "process",
            "label": "make adjust debug",
            "command": "make",
            "args": [
                "DEBUG=1",
                "adjust"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
		{
            "type": "process",
            "label": "make fisher",
            "command": "g++",
            "args": [
                "-DFISHER_MAIN", "fisher.cpp", "-o", "fisher", "-g"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}